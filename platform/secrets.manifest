# Every secret the platform needs, and where each one goes in the cluster.
# Values live in ~/.config/ai-native-sdlc/secrets.env, never in this repository.
#
#   value <NAME> <kind> <required> <description>
#     kind:      password   generated: 22 base58 characters (128 bits), for passwords and
#                           tokens that are only hashed or compared
#                key        generated: 44 base58 characters (256 bits), for strings an app
#                           turns into an encryption or signing key
#                external   issued elsewhere; you put it into secrets.env
#     required:  yes | no   preflight fails when a required external value is missing
#
#   put <namespace>/<secret> <key> <template>
#     The key gets <template> with every ${NAME} replaced by that value; the rest is literal.
#     Several puts may share one value, and one Secret may get several keys.
#
# After changing value lines, regenerate the example:
#   platform/bootstrap.sh --example > platform/secrets.env.example

value  GITEA_ADMIN_PASSWORD           password   yes  password of the Gitea admin user gitea_admin
value  GITEA_SECRET_KEY               key        yes  Gitea SECRET_KEY, hashed into the AES key for 2FA and other stored secrets
value  GITEA_INTERNAL_TOKEN           password   yes  Gitea INTERNAL_TOKEN for its internal API calls
value  PG_GITEA_PASSWORD              password   yes  password of the Postgres role gitea
value  PG_PLANE_PASSWORD              password   yes  password of the Postgres role plane
value  PLANE_SECRET_KEY               key        yes  Plane SECRET_KEY, signs sessions and is hashed into the key for stored settings
value  PLANE_LIVE_SERVER_SECRET_KEY   key        yes  Plane LIVE_SERVER_SECRET_KEY, HMAC key shared by the API and the live server
value  PLANE_RABBITMQ_PASSWORD        password   yes  password of Plane's bundled RabbitMQ
value  PLANE_MINIO_PASSWORD           password   yes  password of Plane's bundled MinIO
value  PLANE_ADMIN_PASSWORD           password   yes  password of the Plane instance admin
value  PLANE_ADMIN_EMAIL              external   yes  email of the Plane instance admin, kept out of the public repo

# Postgres roles, read by CloudNativePG's managed.roles
put  databases/pg-gitea         username                gitea
put  databases/pg-gitea         password                ${PG_GITEA_PASSWORD}
put  databases/pg-plane         username                plane
put  databases/pg-plane         password                ${PG_PLANE_PASSWORD}

# Gitea: admin.existingSecret, and env vars for additionalConfigFromEnvs
put  gitea/gitea-admin          username                gitea_admin
put  gitea/gitea-admin          password                ${GITEA_ADMIN_PASSWORD}
put  gitea/gitea-secrets        secret-key              ${GITEA_SECRET_KEY}
put  gitea/gitea-secrets        internal-token          ${GITEA_INTERNAL_TOKEN}
put  gitea/gitea-secrets        db-password             ${PG_GITEA_PASSWORD}

# Plane: the chart's external_secrets.* take whole env Secrets, so non-secret settings and
# connection strings live here too
put  plane/plane-app-keys       SECRET_KEY              ${PLANE_SECRET_KEY}
put  plane/plane-app-keys       LIVE_SERVER_SECRET_KEY  ${PLANE_LIVE_SERVER_SECRET_KEY}
put  plane/plane-app-env        DATABASE_URL            postgresql://plane:${PG_PLANE_PASSWORD}@platform-pg-rw.databases.svc:5432/plane
put  plane/plane-app-env        AMQP_URL                amqp://plane:${PLANE_RABBITMQ_PASSWORD}@plane-rabbitmq.plane.svc:5672/
put  plane/plane-app-env        REDIS_URL               redis://plane-redis.plane.svc:6379/
# webhooks may target the cluster's pod and service networks (Plane refuses private addresses)
put  plane/plane-app-env        WEBHOOK_ALLOWED_IPS     10.42.0.0/16,10.43.0.0/16
put  plane/plane-app-env        CELERY_WORKER_CONCURRENCY  2
put  plane/plane-live-env       REDIS_URL               redis://plane-redis.plane.svc:6379/
put  plane/plane-rabbitmq       RABBITMQ_DEFAULT_USER   plane
put  plane/plane-rabbitmq       RABBITMQ_DEFAULT_PASS   ${PLANE_RABBITMQ_PASSWORD}
put  plane/plane-doc-store      USE_MINIO               1
put  plane/plane-doc-store      AWS_S3_BUCKET_NAME      uploads
put  plane/plane-doc-store      FILE_SIZE_LIMIT         5242880
put  plane/plane-doc-store      AWS_S3_ENDPOINT_URL     http://plane-minio:9000
put  plane/plane-doc-store      MINIO_ROOT_USER         plane
put  plane/plane-doc-store      MINIO_ROOT_PASSWORD     ${PLANE_MINIO_PASSWORD}
put  plane/plane-doc-store      AWS_ACCESS_KEY_ID       plane
put  plane/plane-doc-store      AWS_SECRET_ACCESS_KEY   ${PLANE_MINIO_PASSWORD}
put  plane/plane-admin          email                   ${PLANE_ADMIN_EMAIL}
put  plane/plane-admin          password                ${PLANE_ADMIN_PASSWORD}
