# Generated from platform/secrets.manifest by: platform/bootstrap.sh --example
# The real file is ~/.config/ai-native-sdlc/secrets.env (mode 0600). Format: NAME=value,
# no quotes. Never put values into this example.

# password of the Gitea admin user gitea_admin (generated by the bootstrap when empty)
GITEA_ADMIN_PASSWORD=

# Gitea SECRET_KEY, hashed into the AES key for 2FA and other stored secrets (generated by the bootstrap when empty)
GITEA_SECRET_KEY=

# Gitea INTERNAL_TOKEN for its internal API calls (generated by the bootstrap when empty)
GITEA_INTERNAL_TOKEN=

# password of the Postgres role gitea (generated by the bootstrap when empty)
PG_GITEA_PASSWORD=

# password of the Postgres role plane (generated by the bootstrap when empty)
PG_PLANE_PASSWORD=

# Plane SECRET_KEY, signs sessions and is hashed into the key for stored settings (generated by the bootstrap when empty)
PLANE_SECRET_KEY=

# Plane LIVE_SERVER_SECRET_KEY, HMAC key shared by the API and the live server (generated by the bootstrap when empty)
PLANE_LIVE_SERVER_SECRET_KEY=

# password of Plane's bundled RabbitMQ (generated by the bootstrap when empty)
PLANE_RABBITMQ_PASSWORD=

# password of Plane's bundled MinIO (generated by the bootstrap when empty)
PLANE_MINIO_PASSWORD=

# password of the Plane instance admin (generated by the bootstrap when empty)
PLANE_ADMIN_PASSWORD=

# email of the Plane instance admin, kept out of the public repo (external, required)
PLANE_ADMIN_EMAIL=

# GitHub token that pushes main to the public mirror (external, optional)
GITHUB_MIRROR_TOKEN=
